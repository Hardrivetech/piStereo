[Unit]
Description=piStereo Now Playing Display
After=graphical.target sound.target
Wants=graphical.target

[Service]
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/opt/pi_headunit/bin/run_python.sh /opt/pi_headunit/src/display_now_playing.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
